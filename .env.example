
.aider*

# Docker
.env
docker-compose.override.yml
postgres_data/
redis_data/

# Backend
/backend/__pycache__/
/backend/*.pyc
/backend/db.sqlite3
/backend/staticfiles/
.env

# Frontend
/frontend/node_modules
/frontend/dist

POSTGRES_DB=backend_db
POSTGRES_USER=backend_user
POSTGRES_PASSWORD=secure_password
DJANGO_SECRET_KEY=change-this-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin$
ADMIN_EMAIL=admin@example.com
DEBUG=1
VITE_API_URL=http://localhost:8032

# Nextcloud WebDAV Configuration
NEXTCLOUD_URL=https://your-nextcloud.com
NEXTCLOUD_USERNAME=your-nextcloud-username
NEXTCLOUD_PASSWORD=your-nextcloud-app-password
NEXTCLOUD_FOLDER=/uploads

# Google Drive Configuration
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_TOKEN=your-oauth-token
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Localization Configuration
TIME_ZONE=Europe/Rome
DEFAULT_LANGUAGE=it

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@sangheeandfabio.com

# Frontend URL (used for email verification redirects)
FRONTEND_URL=http://localhost:5173

# Instagram Social Login
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Frontend environment variables
VITE_DEFAULT_LANGUAGE=it
VITE_SUPPORTED_LANGUAGES=it,ko,en

# Logging Configuration
LOG_LEVEL=INFO
VITE_LOG_LEVEL=error

# ============================================
# Sang Hee & Fabio - Wedding Web App
# Environment Variables
# ============================================

# --- Database ---
POSTGRES_DB=backend_db
POSTGRES_USER=backend_user
POSTGRES_PASSWORD=secure_password

# --- Django ---
DJANGO_SECRET_KEY=change-this-in-production
DEBUG=1

# --- Default Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin$
ADMIN_EMAIL=admin@example.com

# --- Frontend URL (used for email links) ---
FRONTEND_URL=http://localhost:5232

# --- Google OAuth2 (Social Login) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Facebook OAuth2 ---
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --- Instagram OAuth2 ---
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# --- Nextcloud WebDAV ---
NEXTCLOUD_URL=https://your-nextcloud.com
NEXTCLOUD_USERNAME=your-nextcloud-username
NEXTCLOUD_PASSWORD=your-nextcloud-app-password
NEXTCLOUD_FOLDER=/uploads

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Localization ---
TIME_ZONE=Europe/Rome
DEFAULT_LANGUAGE=it

# --- Email (console backend for development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@sangheeandfabio.com

# --- Frontend Build Variables ---
# For production (Docker) leave empty to use relative URLs.
# For local development, set to http://localhost:8032
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_DEFAULT_LANGUAGE=it
VITE_SUPPORTED_LANGUAGES=it,ko,en

# --- Logging ---
LOG_LEVEL=INFO
VITE_LOG_LEVEL=error
